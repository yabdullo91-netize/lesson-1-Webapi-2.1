## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.history/
.ionide/

# Tools
*.pfx
*.publishsettings
*.snk
*.GhostDoc.xml
*.ReSharper
*.v12.suo
*.psess
*.vsp
*.vspx
*.sap
*.cache
*.dgml
*.dbmdl
*.dbproj.schemaview
*.vshost.exe
*.vshost.exe.config
*.vshost.exe.manifest
*.vshost.exe.config.manifest
*.vshost.exe.manifest.config

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# If using NuGet legacy packages.config, uncomment the following line
# !**/[Pp]ackages/repositories.config
# NuGet Symbol Packages
*.snupkg

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.[Cc]ache
~*
*~
*.log
*.swp
*.bak
*.cache
*.temp
*.tmp
*.obj
*.exe
*.dll
*.pdb
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DS_Store
Thumbs.db

# Rider
.idea/

# Local configuration files
appsettings.Local.json
appsettings.Development.json
*.local.json

# Entity Framework Core migrations
# Uncomment the following line if you want to ignore migrations
# [Mm]igrations/

# Backup folders
_Backup/
[Bb]ackup/

# VS Code workspace
.vscode/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
